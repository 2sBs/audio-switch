// Build settings shared by every configuration of the Audio Switch app.

PRODUCT_NAME = Audio Switch
PRODUCT_BUNDLE_IDENTIFIER = com.2sbsi.audio-switch
MARKETING_VERSION = 0.5.2
CURRENT_PROJECT_VERSION = 1

SDKROOT = macosx
// Core Audio process taps, used for playback mirroring, need macOS 14.2.
MACOSX_DEPLOYMENT_TARGET = 14.2
// The Rust core is built for the host architecture only.
ARCHS = arm64
SWIFT_VERSION = 6.0
ALWAYS_SEARCH_USER_PATHS = NO

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Audio Switch
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSMicrophoneUsageDescription = Audio Switch routes the selected microphone into your virtual audio cable.

CODE_SIGN_ENTITLEMENTS = AudioSwitch.entitlements
ENABLE_HARDENED_RUNTIME = YES
// Ad-hoc signing by default. Set DEVELOPMENT_TEAM and CODE_SIGN_IDENTITY in
// Local.xcconfig to keep privacy permissions across rebuilds.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -

// The Rust static library and generated bindings from scripts/build-macos-core.sh.
SWIFT_INCLUDE_PATHS = $(SRCROOT)/Generated
LIBRARY_SEARCH_PATHS = $(SRCROOT)/Generated
OTHER_LDFLAGS = -laudio_switch_ffi -framework CoreAudio -framework CoreFoundation -lobjc
// The build script writes to the Cargo target directory outside the sandbox.
ENABLE_USER_SCRIPT_SANDBOXING = NO

#include? "Local.xcconfig"
